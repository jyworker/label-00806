.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* ========== 顶部区域 ========== */
.header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F5E 100%);
  padding: 60rpx 32rpx 48rpx;
}

.user-section {
  display: flex;
  align-items: center;
}

/* 头像 */
.avatar-btn {
  width: 128rpx !important;
  height: 128rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  overflow: hidden !important;
  background: rgba(255,255,255,0.2) !important;
  border: none !important;
  flex-shrink: 0;
}

.avatar-btn::after {
  display: none !important;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

/* 用户信息 */
.user-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  padding: 0;
  height: 48rpx;
  line-height: 48rpx;
}

.nickname-ph {
  color: rgba(255,255,255,0.7);
}

.phone-row {
  margin-top: 8rpx;
}

.phone {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

/* 未登录 */
.login-section {
  flex: 1;
  margin-left: 24rpx;
}

.login-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.login-tip {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

/* ========== 功能菜单 ========== */
.menu-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

/* ========== 退出登录 ========== */
.logout-section {
  margin: 24rpx;
}

.logout-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: #ff4d4f;
  font-size: 30rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  padding: 0 !important;
  margin: 0 !important;
}

.logout-btn::after {
  display: none;
}

/* ========== 底部 ========== */
.footer {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
}
