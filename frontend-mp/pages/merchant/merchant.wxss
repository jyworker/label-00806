.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 头部 */
.header {
  display: flex;
  padding: 20rpx;
  background: #fff;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.info {
  flex: 1;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 主体 */
.main {
  flex: 1;
  display: flex;
  overflow: hidden;
}
.cate-list {
  width: 160rpx;
  background: #f5f5f5;
}
.cate-item {
  padding: 24rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
.cate-item.active {
  background: #fff;
  color: #ff5000;
  font-weight: bold;
}
.dish-list {
  flex: 1;
  background: #fff;
}
.group-title {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  background: #fafafa;
}
.dish-card {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}
.dish-img-wrap {
  width: 140rpx;
  height: 140rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
}
.dish-img-default {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.dish-name {
  font-size: 28rpx;
  color: #333;
}
.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dish-price {
  font-size: 32rpx;
  color: #ff5000;
  font-weight: bold;
}
.counter {
  display: flex;
  align-items: center;
}
.btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}
.btn.plus {
  background: #ff5000;
  color: #fff;
}
.btn.minus {
  border: 2rpx solid #ff5000;
  color: #ff5000;
  box-sizing: border-box;
}
.num {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}
.bottom-space {
  height: 120rpx;
}

/* 底部 */
.footer {
  display: flex;
  align-items: center;
  height: 100rpx;
  background: #333;
  padding: 0 20rpx;
}
.cart-info {
  flex: 1;
  display: flex;
  align-items: center;
}
.cart-icon {
  font-size: 44rpx;
  position: relative;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff5000;
  border-radius: 16rpx;
  padding: 0 8rpx;
}
.cart-detail {
  margin-left: 16rpx;
}
.total {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}
.tip {
  display: block;
  font-size: 20rpx;
  color: #999;
}
.empty {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #999;
}
.pay-btn {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  background: #555;
  border-radius: 35rpx;
}
.pay-btn.active {
  color: #fff;
  background: #ff5000;
}
