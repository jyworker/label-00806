<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="label">联系人</text>
      <input class="input" placeholder="请输入联系人姓名" value="{{form.contactName}}" bindinput="onInput" data-field="contactName" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{form.contactPhone}}" bindinput="onInput" data-field="contactPhone" />
    </view>
    <view class="form-item">
      <text class="label">详细地址</text>
      <input class="input" placeholder="请输入详细地址" value="{{form.detail}}" bindinput="onInput" data-field="detail" />
    </view>
    <view class="form-item">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault === 1}}" bindchange="onSwitchChange" color="#FF6B35" />
    </view>
  </view>
  <view class="btn-group">
    <button class="save-btn" bindtap="saveAddress">保存</button>
    <button class="delete-btn" wx:if="{{form.id}}" bindtap="deleteAddress">删除</button>
  </view>
</view>
