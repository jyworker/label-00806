<view class="container">
  <view class="address-list">
    <view class="address-item" wx:for="{{addresses}}" wx:key="id" bindtap="selectAddress" data-item="{{item}}">
      <view class="address-info">
        <view class="address-contact">
          <text class="name">{{item.contactName}}</text>
          <text class="phone">{{item.contactPhone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <view class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
      </view>
      <view class="address-edit" catchtap="editAddress" data-item="{{item}}">编辑</view>
    </view>
  </view>
  <view class="empty" wx:if="{{addresses.length === 0}}">
    <text class="empty-text">暂无收货地址</text>
  </view>
  <view class="add-btn" bindtap="addAddress">+ 新增收货地址</view>
</view>
